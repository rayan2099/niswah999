# Flutter app environment -- STAGING build only.
# Copy to `.env.staging` (gitignored) and build with
# `flutter run --dart-define=APP_ENV=staging` or by loading this file in
# place of `.env`. Kept entirely separate from the production `.env` so a
# staging build is structurally incapable of silently using production's
# URL/key.
APP_ENV="staging"

# Staging Supabase project's own public, client-safe values. Never the
# production project's. SUPABASE_ANON_KEY holds the new `publishable` key
# where available (see scripts/lib/supabase_management_api.py) -- it is
# used the same way a legacy anon key is.
SUPABASE_URL="https://your-staging-project.supabase.co"
SUPABASE_ANON_KEY="your-staging-publishable-or-anon-key"

SENTRY_DSN=""
