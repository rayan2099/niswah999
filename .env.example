# Flutter app environment
APP_ENV="development"

# Supabase client configuration.
# These are public, client-safe values. Never add the service role key here.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Backward-compatible aliases retained for existing local tooling.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Sentry crash/error reporting DSN (OB-006). A DSN is write-only and safe to
# ship in a client app by Sentry's own design, but is still kept out of
# source and read per-environment like everything else here. Leave empty to
# run with no crash-reporting destination (e.g. local dev before a Sentry
# project exists) — AppErrorReporter falls back to debugPrint-only in that
# case, exactly as it did before this integration existed.
SENTRY_DSN=""

# ---------------------------------------------------------------------------
# Gemini API key: NOT a client .env value.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY must never appear in this file, in the app's bundled .env,
# or anywhere reachable from the compiled Flutter client. The Flutter app
# calls Gemini only through Supabase Edge Functions (dr-niswah-chat,
# fiqh-advisor-chat, dream-interpreter-chat, ai-assistant-chat), each of
# which reads GEMINI_API_KEY as a server-side secret:
#
#   supabase secrets set GEMINI_API_KEY=<key> --project-ref <ref>
#
# For local development, set it in supabase/functions/.env (gitignored,
# read automatically by `supabase functions serve`) — never in this file.
