node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Android release signing — a keystore/its passwords must never be
# committed (DC-005/SEC-003/RD-001 remediation).
android/key.properties
android/app/*.jks
android/app/*.keystore
*.jks
*.keystore

# Flutter/Dart build caches — regenerated by `flutter pub get`/`flutter run`,
# never meant to be committed.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
# Widget Preview related
.widget_preview/
.vercel

# Golden-test failure diffs are regenerated locally on every failing run —
# never meant to be committed.
test/failures/

# KB production-candidate/quarantine/seed-SQL output — deterministically
# regenerated by scripts/build_kb_production_candidates.py and
# scripts/render_kb_seed_sql.py from the frozen evidence snapshot; never
# meant to be committed.
production-readiness-results/knowledge-base/generated/

# Python bytecode cache from running scripts/test_*.py locally.
__pycache__/
*.pyc
